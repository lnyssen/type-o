node_modules/
dist/
server/.venv/
__pycache__/
.DS_Store
*.log
tmp/

# Variable masters are downloaded from github.com/google/fonts (OFL); keep only
# their licences and metadata in git. `npm run setup:masters` rebuilds the rest,
# and .vercelignore lets them through to a deployment.
server/masters/*/*.ttf
server/masters/*/*.woff2
server/masters/*/charset.json
.vercel
.env*

# Scratch output from scripts/lab-specimen.mjs and friends: served by the dev
# server so it can be looked at, never part of a build.
client/public/*
!client/public/.gitkeep
