node_modules/
dist/
server/.venv/
__pycache__/
.DS_Store
*.log
tmp/

# The variable masters live in git. They are OFL, so redistributing them is
# what the licence is for, and a deployment from GitHub cannot build without
# them — `npm run setup:masters` only has to run when a family is added.
.vercel
.env*

# Scratch output from scripts/lab-specimen.mjs and friends: served by the dev
# server so it can be looked at, never part of a build.
client/public/*
!client/public/.gitkeep
